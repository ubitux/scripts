#!/usr/bin/env zsh

set -eu

mbase=/run/user/$(id -u)/gvfs

mount_device() {
    local bname=$1
    local mpoint=$mbase/mtp:host=$bname
    if [ -d $mpoint ]; then
        echo "$bname already mounted to $mpoint"
    else
        echo "Mounting $bname to $mpoint"
        gio mount mtp://$bname
    fi
}

if [ "$#" -gt 0 ]; then
    mount_device "$1"
else
    for x in $(gio mount -li | grep activation_root=mtp://|grep -v keyboard); do
        mount_device "${${x#*mtp://}%*/}"
    done
fi
