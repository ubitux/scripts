#!/usr/bin/env python3

import argparse
import shlex
import shutil
import subprocess
import threading
from collections.abc import Callable
from dataclasses import dataclass
from functools import cache
from pathlib import Path

import toml
from wcwidth import wcswidth


@dataclass
class File:
    path: Path
    perms: int | None = None
    usr: str | None = None
    grp: str | None = None
    chk: tuple[int, int] | None = None

    @property
    def sig(self):
        return (self.perms, self.usr, self.grp, self.chk)


@dataclass
class Dir:
    path: Path
    perms: int | None = None
    usr: str | None = None
    grp: str | None = None

    @property
    def sig(self):
        return (self.perms, self.usr, self.grp)


@dataclass
class User:
    login: str
    shell: str | None = None
    home: str | None = None
    linger: bool = False
    groups: frozenset[str] = frozenset()
    uid: int | None = None

    @property
    def sig(self):
        return (self.shell, self.home, self.linger, self.groups)


@dataclass(order=True)
class Service:
    name: str
    login: str = ""

    @property
    def cmd(self) -> list[str]:
        args = ["systemctl"]
        if self.login:
            args += ["--user", f"--machine={self.login}@.host"]
        return args


def wpad(s: str, n: int) -> str:
    return s + (n - wcswidth(s)) * " "


def yesno(v: bool) -> str:
    return "yes" if v else "no"


class Table:
    def __init__(self, *cols: str):
        self.rows = [list(cols)]

    def add_row(self) -> list[str]:
        row = [""] * len(self.rows[0])
        self.rows.append(row)
        return row

    def __str__(self) -> str:
        ncols = len(self.rows[0])
        lengths = [0] * ncols
        for row in self.rows:
            for col_id, entry in enumerate(row):
                lengths[col_id] = max(lengths[col_id], wcswidth(entry))

        s = "\n"
        for i, row in enumerate(self.rows):
            s += " "
            if i == 0:
                s += "\033[1m\033[4m"  # bold, underline
            s += "│".join(" %s " % wpad(e, p) for e, p in zip(row, lengths))
            if i == 0:
                s += "\033[0m"
            s += "\n"
        return s


@cache
def cfg_dir() -> Path:
    return Path.home() / "infra"  # TODO: make this configurable


def load_cfg() -> dict:
    fpath = cfg_dir() / "infra.toml"
    with open(fpath, "r") as f:
        return toml.load(f)


def parse_chk(s: str) -> tuple[int, int]:
    chksum, size, _ = s.split(maxsplit=2)
    return (int(chksum), int(size))


@dataclass
class ModStatus:
    packages: list[tuple[str, bool]]
    users: list[tuple[User, User]]
    dirs: list[tuple[Dir, Dir]]
    files: list[tuple[File, File]]
    services: list[tuple[Service, str, str, bool]]


@dataclass
class MachineStatus:
    name: str
    status: ModStatus


def get_module_status(name: str, mod):
    has_changes = False

    packages = []
    if requested_pkgs := mod.get("packages", []):
        rstat = ssh_exec_text(name, ["pacman", "-Qq"] + requested_pkgs)
        remote_pkgs = set(rstat.stdout.split())
        missing_pkgs = set(requested_pkgs) - remote_pkgs
        if missing_pkgs:
            has_changes = True
        for pkg in requested_pkgs:
            packages.append((pkg, pkg in missing_pkgs))

    # Local users
    users_spec = mod.get("users", {})
    src_users = []
    for login, user_spec in users_spec.items():
        src = User(
            login,
            user_spec.get("shell", "/bin/bash"),
            user_spec.get("home", f"/home/{login}"),
            user_spec.get("linger", False),
            frozenset(user_spec.get("groups", [])),
        )
        src_users.append(src)

    # Remote users
    dst_users = []
    for login in users_spec:
        dst = User(login)
        r = ssh_exec_text(name, ["getent", "passwd", login])
        if r.returncode == 0:
            fields = r.stdout.rstrip().split(":")
            *_, dst.home, dst.shell = fields
            dst.uid = int(fields[2])
            if users_spec[login].get("groups"):
                r = ssh_exec_text(name, ["id", "-Gn", login])
                r.check_returncode()
                dst.groups = frozenset(r.stdout.split())
        elif r.returncode != 2:  # getent: key not found
            r.check_returncode()
        # loginctl show-user is not reliable for users without a session
        rlinger = ssh_exec_text(
            name, ["test", "-e", f"/var/lib/systemd/linger/{login}"]
        )
        if rlinger.returncode not in (0, 1):
            rlinger.check_returncode()
        dst.linger = rlinger.returncode == 0
        dst_users.append(dst)

    # Local users vs remote users
    users = []
    for src, dst in zip(src_users, dst_users):
        src.groups |= dst.groups
        users.append((src, dst))
        has_changes |= src.sig != dst.sig

    # Aggregate user files ownership
    files_spec = mod.get("files", []) + [
        {"own": f"{login}:{login}", **file_spec}
        for login, user in users_spec.items()
        for file_spec in user.get("files", [])
    ]

    # Local files
    srcdir = cfg_dir() / "targets" / name
    src_files = []
    for file_spec in files_spec:
        path = file_spec["src"]
        local_path = srcdir / path
        perms = file_spec.get("perms", 0o644)
        usr, grp = file_spec.get("own", "root:root").split(":", maxsplit=1)
        r = subprocess.run(
            ["cksum", local_path],
            text=True,
            capture_output=True,
            check=True,
        )
        chk = parse_chk(r.stdout)
        file = File(local_path, perms, usr, grp, chk)
        src_files.append(file)

    # Remote files
    dst_files = []
    for file_spec in files_spec:
        path = file_spec["dst"]
        rstat = ssh_exec_text(name, ["stat", "-c", "%U %G %a", path])
        rchk = ssh_exec_text(name, ["cksum", path])
        file = File(Path(path))
        if rstat.returncode == 0:
            rchk.check_returncode()
            file.usr, file.grp, perms = rstat.stdout.split(maxsplit=3)
            file.perms = int(perms, 8)
            file.chk = parse_chk(rchk.stdout)
        dst_files.append(file)

    # Local files vs remote files
    files = []
    for src, dst in zip(src_files, dst_files):
        files.append((src, dst))
        has_changes |= src.sig != dst.sig

    # Aggregate user dirs ownership
    dirs_spec = mod.get("dirs", []) + [
        {"own": f"{login}:{login}", **dir_spec}
        for login, user in users_spec.items()
        for dir_spec in user.get("dirs", [])
    ]

    # Local dirs
    src_dirs = []
    for dir_spec in dirs_spec:
        path = dir_spec["path"]
        perms = dir_spec.get("perms", 0o755)
        usr, grp = dir_spec.get("own", "root:root").split(":", maxsplit=1)
        src_dirs.append(Dir(path, perms, usr, grp))

    # Remote dirs
    dst_dirs = []
    for dir_spec in dirs_spec:
        path = dir_spec["path"]
        rstat = ssh_exec_text(name, ["stat", "-c", "%U %G %a %F", path])
        dir = Dir(Path(path))
        if rstat.returncode == 0:
            dir.usr, dir.grp, perms, kind = rstat.stdout.strip().split(maxsplit=3)
            if kind != "directory":
                raise ValueError(f"{name}: {path} is not a directory ({kind})")
            dir.perms = int(perms, 8)
        dst_dirs.append(dir)

    # Local dirs vs remote dirs
    dirs = []
    for src, dst in zip(src_dirs, dst_dirs):
        dirs.append((src, dst))
        has_changes |= src.sig != dst.sig

    service_specs = [Service(s) for s in mod.get("services", [])]
    service_specs += [
        Service(s, login)
        for login, user in users_spec.items()
        for s in user.get("services", [])
    ]
    services = []
    for service in service_specs:
        r_enabled = ssh_exec_text(name, service.cmd + ["is-enabled", service.name])
        r_active = ssh_exec_text(name, service.cmd + ["is-active", service.name])
        is_enabled = r_enabled.stdout.rstrip() or "unknown"
        is_active = r_active.stdout.rstrip() or "unknown"
        need_restart = r_enabled.returncode or r_active.returncode or has_changes
        services.append((service, is_enabled, is_active, need_restart))

    return ModStatus(packages, users, dirs, files, services)


def get_machine_status(data, name: str, target) -> MachineStatus:
    merged = ModStatus([], [], [], [], [])
    mods = [data["mods"][mod_id] for mod_id in target.get("mods", [])]
    for mod in [*mods, target]:
        status = get_module_status(name, mod)
        merged.packages += status.packages
        merged.users += status.users
        merged.dirs += status.dirs
        merged.files += status.files
        merged.services += status.services
    return MachineStatus(name, merged)


def report_host(name: str):
    width = shutil.get_terminal_size().columns
    title = f" 🖥️ {name} "
    print(f"\n\033[1;7m{title:<{max(0, width)}}\033[0m")  # bold + reverse video


def report_machine(mstatus: MachineStatus):
    report_host(mstatus.name)
    st = mstatus.status

    if st.packages:
        table = Table("Package", "Installed")
        for package, missing in sorted(st.packages):
            row = table.add_row()
            row[0] = get_icon(not missing) + " " + package
            row[1] = yesno(not missing)
        print(table)

    if st.users:
        table = Table("Login", "Shell", "Home", "Linger", "Groups")
        for src, dst in sorted(st.users, key=lambda u: u[0].login):
            row = table.add_row()
            row[0] = get_icon(src.sig == dst.sig) + " " + src.login
            row[1] = get_report(src.shell, dst.shell)
            row[2] = get_report(src.home, dst.home)
            row[3] = get_report(src.linger, dst.linger, fmt=yesno)
            row[4] = get_report(
                src.groups, dst.groups, fmt=lambda x: ", ".join(sorted(x)) or "—"
            )
        print(table)

    if st.dirs:
        table = Table("Path", "Perms", "User", "Group")
        for src, dst in sorted(st.dirs, key=lambda d: d[1].path):
            row = table.add_row()
            row[0] = get_icon(src.sig == dst.sig) + " " + dst.path.as_posix()
            row[1] = get_report(src.perms, dst.perms, fmt=lambda x: format(x, "o"))
            row[2] = get_report(src.usr, dst.usr)
            row[3] = get_report(src.grp, dst.grp)
        print(table)

    if st.files:
        table = Table("Path", "Perms", "User", "Group", "Content")
        for src, dst in sorted(st.files, key=lambda f: f[1].path):
            row = table.add_row()
            row[0] = get_icon(src.sig == dst.sig) + " " + dst.path.as_posix()
            row[1] = get_report(src.perms, dst.perms, fmt=lambda x: format(x, "o"))
            row[2] = get_report(src.usr, dst.usr)
            row[3] = get_report(src.grp, dst.grp)
            row[4] = get_report(src.chk, dst.chk, fmt=lambda x: f"{x[0]:08x}")
        print(table)

    if st.services:
        table = Table("Service", "Login", "Active", "Enabled", "Need restart")
        for service, is_enabled, is_active, need_restart in sorted(st.services):
            row = table.add_row()
            ok = (is_enabled, is_active, need_restart) == ("enabled", "active", False)
            row[0] = get_icon(ok) + " " + service.name
            row[1] = service.login or "system"
            row[2] = is_active
            row[3] = is_enabled
            row[4] = yesno(need_restart)
        print(table)


def get_icon(ok: bool) -> str:
    return "✅" if ok else "🟠"


def get_report(src, dst, fmt: Callable | None = None) -> str:
    diff = src != dst
    if fmt is not None:
        src = fmt(src)
        if dst is not None:
            dst = fmt(dst)
    if dst is None:
        dst = "ø"
    return f"{dst} → {src}" if diff else src


@dataclass
class Cmd:
    host: str
    desc: str
    args: list[str]

    def execute(self, dry: bool):
        cmd = shlex.join(self.args)
        if dry:
            print(f"{self.host} would exec: {cmd}")
        else:
            print(f"{self.host} exec: {cmd}")
            if self.args[0] == "scp":
                subprocess.run(self.args, check=True)
            else:
                ssh_exec(self.host, self.args)


def build_cmd_queue(mstatus: MachineStatus) -> list[Cmd]:
    cmds = []
    st = mstatus.status
    name = mstatus.name
    reload_systemd = False
    restart_users = set()

    missing = sorted(pkg for pkg, missing in st.packages if missing)
    if missing:
        args = ["pacman", "-Syu", "--noconfirm"] + missing
        cmds.append(Cmd(name, "Install missing packages", args))

    for src, dst in sorted(st.users, key=lambda u: u[0].login):
        if dst.home is None:
            args = ["useradd", "-m", "-d", src.home, "-s", src.shell, "--", src.login]
            cmds.append(Cmd(name, "Create user", args))
        else:
            args = ["usermod"]
            if src.home != dst.home:
                args += ["-d", src.home]
            if src.shell != dst.shell:
                args += ["-s", src.shell]
            if len(args) > 1:
                args += ["--", src.login]
                cmds.append(Cmd(name, "Update user", args))
        if missing_groups := sorted(src.groups - dst.groups):
            args = ["usermod", "-aG", ",".join(missing_groups), "--", src.login]
            cmds.append(Cmd(name, "Add user to groups", args))
            if dst.uid is not None and (src.linger or dst.linger):
                restart_users.add(dst.uid)
        if src.linger != dst.linger:
            action = "enable-linger" if src.linger else "disable-linger"
            cmds.append(Cmd(name, "Set user linger", ["loginctl", action, src.login]))

    for src, dst in sorted(st.dirs, key=lambda d: d[1].path):
        if None in (dst.perms, dst.usr, dst.grp):
            args = ["mkdir", "-p", dst.path.as_posix()]
            cmds.append(Cmd(name, "Create directory", args))
        ownership_changed = src.usr != dst.usr or src.grp != dst.grp
        if ownership_changed:
            args = ["chown", f"{src.usr}:{src.grp}", dst.path.as_posix()]
            cmds.append(Cmd(name, "Set directory ownership", args))
        if src.perms != dst.perms or ownership_changed:
            args = ["chmod", format(src.perms, "o"), dst.path.as_posix()]
            cmds.append(Cmd(name, "Set directory permissions", args))

    for src, dst in sorted(st.files, key=lambda f: f[1].path):
        if src.chk != dst.chk:
            dst_file = get_host(name) + f":{dst.path.as_posix()}"
            args = ["scp", src.path.as_posix(), dst_file]
            cmds.append(Cmd(name, "Upload file", args))
            reload_systemd |= "/systemd/" in dst.path.as_posix()
        ownership_changed = src.usr != dst.usr or src.grp != dst.grp
        if ownership_changed:
            args = ["chown", f"{src.usr}:{src.grp}", dst.path.as_posix()]
            cmds.append(Cmd(name, "Set file ownership", args))
        if src.perms != dst.perms or ownership_changed or src.chk != dst.chk:
            args = ["chmod", format(src.perms, "o"), dst.path.as_posix()]
            cmds.append(Cmd(name, "Set file permissions", args))

    for uid in sorted(restart_users):
        args = ["systemctl", "restart", f"user@{uid}.service"]
        cmds.append(Cmd(name, "Restart user manager to apply groups", args))

    if reload_systemd:
        cmds.append(Cmd(name, "Reload systemd units", ["systemctl", "daemon-reload"]))
        for login in sorted({s.login for s, *_ in st.services if s.login}):
            args = Service("", login).cmd + ["daemon-reload"]
            cmds.append(Cmd(name, "Reload user systemd units", args))

    for service, is_enabled, is_active, need_restart in sorted(st.services):
        if is_enabled != "enabled":
            args = service.cmd + ["enable", service.name]
            cmds.append(Cmd(name, "Enable service", args))
        if is_active != "active" or need_restart:
            args = service.cmd + ["restart", service.name]
            cmds.append(Cmd(name, "Restart service", args))

    return cmds


@cache
def get_host(name: str) -> str:
    return f"root@{name}"


@cache
def ssh_cmd(name: str) -> list[str]:
    return ["ssh", "-o", f"ControlPath=/tmp/sock-{name}", get_host(name)]


def ssh_exec(name: str, cmd: list[str]):
    subprocess.run(
        ssh_cmd(name) + [shlex.join(cmd)],
        capture_output=True,
        check=True,
    )


def ssh_exec_text(name: str, cmd: list[str]):
    return subprocess.run(
        ssh_cmd(name) + [shlex.join(cmd)],
        text=True,
        capture_output=True,
        check=False,
    )


def ssh_open(name: str):
    subprocess.run(ssh_cmd(name) + ["-MNf"], capture_output=True, check=True)


def ssh_exit(name: str):
    subprocess.run(ssh_cmd(name) + ["-O", "exit"], capture_output=True, check=True)


class WorkerProbe(threading.Thread):
    def __init__(self, data, name, target):
        super().__init__()
        self.name = name
        self._data = data
        self._target = target
        self.result: MachineStatus | None = None
        self.error: Exception | None = None

    def run(self):
        print(f"→ Probing info for {self.name}...")
        try:
            try:
                ssh_open(self.name)
                self.result = get_machine_status(self._data, self.name, self._target)
            finally:
                ssh_exit(self.name)
        except Exception as error:
            self.error = error
            return
        print(f"← Got info from {self.name}")


def select_targets(data, targets: list[str] | None = None) -> dict:
    configured = data.get("targets", {})
    if targets:
        unknown = set(targets) - configured.keys()
        if unknown:
            raise SystemExit(f"Unknown targets: {', '.join(sorted(unknown))}")
    return {
        name: target
        for name, target in configured.items()
        if not targets or name in targets
    }


def probe_info(targets: list[str] | None = None) -> list[MachineStatus]:
    data = load_cfg()

    threads = []
    for name, target in select_targets(data, targets).items():
        threads.append(WorkerProbe(data, name, target))

    for t in threads:
        t.start()

    for t in threads:
        t.join()

    for t in threads:
        if t.error is not None:
            raise RuntimeError(f"Failed to probe {t.name}") from t.error

    return [t.result for t in threads if t.result is not None]


def cmd_check(targets: list[str] | None = None):
    results = probe_info(targets)
    for result in results:
        report_machine(result)


def cmd_dryrun(targets: list[str] | None = None):
    results = probe_info(targets)
    for result in results:
        queue = build_cmd_queue(result)
        for cmd in queue:
            cmd.execute(dry=True)


def cmd_run(targets: list[str] | None = None):
    results = probe_info(targets)
    for result in results:
        queue = build_cmd_queue(result)
        for cmd in queue:
            cmd.execute(dry=False)


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument(
        "command",
        choices=["check", "dryrun", "run"],
        help="Command",
    )
    parser.add_argument(
        "-t",
        "--target",
        action="append",
        metavar="NAME",
        help="Only operate on this target (repeat for multiple targets; default: all)",
    )
    args = parser.parse_args()

    if args.command == "check":
        cmd_check(args.target)
    elif args.command == "dryrun":
        cmd_dryrun(args.target)
    elif args.command == "run":
        cmd_run(args.target)


if __name__ == "__main__":
    main()
